// Prisma schema for the School Fee Collection System
// Live DB: Postgres on the app server; Supabase keeps a 15-minute backup copy.
//
// Multi-campus: every record carries campusId. Campuses are fully separate — queries are always
// scoped to the signed-in user's campus (lib/scope.ts).
//
// Money is stored as Int (whole rupees) — exact sums, no float rounding drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // used for migrations
}

enum Role {
  ADMIN
  MANAGER
}

enum StudentStatus {
  ACTIVE
  LEFT
}

enum FeeType {
  ADMISSION
  MONTHLY
  PAPER_FUND
}

// Charges whose amount is decided month by month for the whole campus (not per student).
enum ChargeKind {
  PAPER_FUND
}

enum SubmissionStatus {
  PENDING
  CONFIRMED
}

// Admin's own expenses are APPROVED on creation; a manager's start PENDING until Admin reviews them.
enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Campus {
  id        String   @id
  name      String   @unique
  code      String   @unique // short slug, e.g. "boys"
  createdAt DateTime @default(now())

  users          User[]
  students       Student[]
  feePayments    FeePayment[]
  submissions    Submission[]
  expenses       Expense[]
  monthlyCharges MonthlyCharge[]

  @@map("campuses")
}

model User {
  id            String   @id @default(cuid())
  name          String
  username      String   @unique
  passwordHash  String
  role          Role
  phone         String?
  isActive      Boolean  @default(true) // deactivated managers can't log in; their history stays
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id])

  studentsAdded        Student[]    @relation("StudentCreatedBy")
  feePayments          FeePayment[] @relation("PaymentCollectedBy")
  submissions          Submission[] @relation("SubmittedBy")
  confirmedSubmissions Submission[] @relation("ConfirmedBy")
  expensesAdded        Expense[]    @relation("ExpenseAddedBy")
  expensesReviewed     Expense[]    @relation("ExpenseReviewedBy")
  chargesSet           MonthlyCharge[]

  @@index([campusId, role])
  @@map("users")
}

model Student {
  id            String        @id @default(cuid())
  name          String
  fatherName    String
  className     String        // free text, required — e.g. "Class 5", "Nursery", "8-B"
  phoneNumber   String
  admissionFee  Int?          // one-time, optional
  monthlyFee    Int           // recurring, required, differs per student
  admissionDate DateTime?
  status        StudentStatus @default(ACTIVE)
  leftAt        DateTime?     // set when marked LEFT — monthly fees stop accruing after this month
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdById   String
  createdBy     User          @relation("StudentCreatedBy", fields: [createdById], references: [id])

  campusId      String
  campus        Campus        @relation(fields: [campusId], references: [id])

  feePayments   FeePayment[]

  @@index([campusId, status])
  @@index([status])
  @@index([name])
  @@index([fatherName])
  @@index([className])
  @@map("students")
}

model FeePayment {
  id            String   @id @default(cuid())
  amount        Int
  feeType       FeeType
  forMonth      String?  // "YYYY-MM" — for MONTHLY and PAPER_FUND
  paymentDate   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])

  collectedById String
  collectedBy   User     @relation("PaymentCollectedBy", fields: [collectedById], references: [id])

  campusId      String
  campus        Campus   @relation(fields: [campusId], references: [id])

  @@index([campusId, paymentDate])
  @@index([studentId])
  @@index([collectedById, paymentDate])
  @@index([paymentDate])
  @@map("fee_payments")
}

model Submission {
  id             String           @id @default(cuid())
  amount         Int
  submissionDate DateTime         @default(now())
  status         SubmissionStatus @default(PENDING)
  notes          String?
  confirmedAt    DateTime?

  submittedById  String
  submittedBy    User             @relation("SubmittedBy", fields: [submittedById], references: [id])

  confirmedById  String?
  confirmedBy    User?            @relation("ConfirmedBy", fields: [confirmedById], references: [id])

  campusId       String
  campus         Campus           @relation(fields: [campusId], references: [id])

  @@index([campusId, status])
  @@index([submittedById, submissionDate])
  @@index([status])
  @@map("submissions")
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String?  // Salary | Utilities | Supplies | Maintenance | Other
  amount      Int
  expenseDate DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addedById   String
  addedBy     User     @relation("ExpenseAddedBy", fields: [addedById], references: [id])

  status       ExpenseStatus @default(APPROVED)
  reviewedAt   DateTime?
  reviewNote   String?       // e.g. reason for rejection
  reviewedById String?
  reviewedBy   User?         @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id])

  campusId     String
  campus       Campus        @relation(fields: [campusId], references: [id])

  @@index([campusId, status, expenseDate])
  @@index([expenseDate])
  @@index([status])
  @@index([addedById, status])
  @@index([category])
  @@map("expenses")
}

// One amount per campus per month (e.g. Paper Fund Oct 2026 = Rs 150). A month with no row = not set yet.
model MonthlyCharge {
  id        String     @id @default(cuid())
  kind      ChargeKind @default(PAPER_FUND)
  forMonth  String     // "YYYY-MM"
  amount    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  campusId  String
  campus    Campus     @relation(fields: [campusId], references: [id])

  setById   String
  setBy     User       @relation(fields: [setById], references: [id])

  @@unique([campusId, kind, forMonth])
  @@map("monthly_charges")
}
